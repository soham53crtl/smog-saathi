# Pick ONE provider by setting its key (never commit the real .env).
# xAI Grok  -> https://console.x.ai      (keys start with xai-)
XAI_API_KEY=
# Groq      -> https://console.groq.com  (keys start with gsk_)
GROQ_API_KEY=
# Google Gemini -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: force a provider (xai | groq | gemini) when several keys are set
LLM_PROVIDER=
# Optional: override the default model (names change, check the provider's models page)
LLM_MODEL=

PORT=3000
# Daily cap on AI calls, protects your key from abuse
AI_DAILY_LIMIT=500
# Set to 1 only behind a trusted reverse proxy (Render, Vercel, nginx)
TRUST_PROXY=0
