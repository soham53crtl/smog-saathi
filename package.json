{
  "name": "smog-saathi",
  "version": "1.0.0",
  "description": "GenAI assistant that helps families and communities navigate severe winter smog.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node backend.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "build": "node scripts/build-public.js",
    "format": "prettier --write \"**/*.{js,css,json}\"",
    "format:check": "prettier --check \"**/*.{js,css,json}\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "homepage": "https://smog-saathi.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soham53crtl/smog-saathi.git"
  },
  "keywords": [
    "air-quality",
    "aqi",
    "smog",
    "genai",
    "accessibility",
    "vercel"
  ]
}
